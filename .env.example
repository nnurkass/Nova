# ===================================================================
# Nova — Environment Variables Template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to git (it is gitignored)
# ===================================================================

# --- Anthropic LLM ---
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Goszakup.gov.kz API ---
# Get from: goszakup.gov.kz → Profile → Settings → API Token
# Requires active ECP (ЭЦП) for your organization
GOSZAKUP_TOKEN=your_goszakup_token_here
GOSZAKUP_GRAPHQL_URL=https://ows.goszakup.gov.kz/v3/graphql

# --- PostgreSQL ---
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://nova_user:nova_pass@localhost:5432/nova_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LangSmith (tracing & monitoring) ---
# Get from: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=nova-construction-ai
LANGCHAIN_TRACING_V2=true

# --- ABC Smetnie Resheniya (file-based integration) ---
# Absolute paths to shared folders used for XML import/export
ABC_EXPORT_PATH=/data/abc/exports
ABC_IMPORT_PATH=/data/abc/imports

# --- Application settings ---
APP_ENV=development
# Options: development | production
LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
